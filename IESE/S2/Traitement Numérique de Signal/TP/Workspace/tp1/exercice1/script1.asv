s = audioread('SCHUBERT.WAV');
size(s); length(s);
min(s); max(s);
s = s(1:1024);
plot(s), title('Signal Initial')


function Sres = quantlin(s, B)
    J = 2^B;
    q = 2 / J;
    j = floor(s / q);
    Sres = q .* (j + 1/2);

    subplot(2,1,1);
    plot(s);
    title('Signal Original');

    subplot(2,1,2);
    plot(Sres);
    title('Signal Quantifié');
end

Sres = quantlin(s, 8);


function [bq,e] = quantification1(s,B)

    N = length(s);
    Sres = quantlin(s,B);
    bq = s - Sres;
    e = (1/N)*sum((bq).^2);

    figure
    subplot(2,1,1)
    plot(bq)
    title(['Bruit de quantification = ',num2str(B)])
    
    subplot(2,1,2)
    stem(e)
    title(['Puissance derreur = ',num2str(e)])

end


[bq4,e4] = quantification1(s,4);
