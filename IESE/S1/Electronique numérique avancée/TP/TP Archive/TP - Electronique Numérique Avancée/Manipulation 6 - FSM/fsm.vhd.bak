library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_unsigned.all;
use ieee.numeric_std.all;

-- 7 Seg Compteur
entity Afficheur_Compteur is
port(
	clk_50, reset, mode : in std_logic;
	Afficheur : out std_logic_vector(6 downto 0)
);
end;


architecture behavior of Afficheur_Compteur is

signal clk: std_logic := '0';
signal div : std_logic_vector(23 downto 0);
signal A : std_logic_vector(3 downto 0);

begin
process(clk_50, reset)
	begin 
	if reset = '0' then 
			div <= (others => '0');
			
	elsif rising_edge(clk_50) then 
			div <= div + 1;
		
	end if;
	
end process;


clk <= div(25);


process(clk, reset)
begin 
	if reset = '0' then 
			A <= "0000";			
	elsif rising_edge(clk) then
        if mode = '1' then   
            A <= A + 1;
        else                 
            A <= A - 1;
        end if;
    end if;
end process;
 


end;